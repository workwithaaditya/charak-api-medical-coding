// CHARAK API - Medical Coding System Database Schema
// Comprehensive medical database with dual coding system support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Hashed password
  role      UserRole
  email     String?  @unique
  firstName String?
  lastName  String?
  department String? // User's department/college
  year      Int?     // Academic year
  profilePicture String?
  isEmailVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  sessions     Session[]
  diagnoses    Diagnosis[] @relation("DoctorDiagnoses")
  
  // Campus Connect Hub Relations
  createdEvents     Event[] @relation("EventCreator")
  eventAttendees    EventAttendee[]
  notifications     EventNotification[]
  digests          EventDigest[]
  eventPreferences UserEventPreference?
  
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

// Medical Disorders with Dual Coding System
model Disorder {
  id          String @id @default(cuid())
  englishName String
  sanskritName String
  icd11Code   String
  namasteCode String
  category    String
  description String?
  confidence  Int    @default(100)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  diagnoses   Diagnosis[]
  symptoms    DisorderSymptom[]
  
  @@map("disorders")
  @@index([englishName])
  @@index([sanskritName])
  @@index([icd11Code])
  @@index([namasteCode])
}

// Patient Management with ABHA Integration
model Patient {
  id          String    @id @default(cuid())
  abhaId      String    @unique
  firstName   String?
  lastName    String?
  dateOfBirth DateTime?
  gender      Gender?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  diagnoses   Diagnosis[]
  history     PatientHistory[]
  
  @@map("patients")
  @@index([abhaId])
}

// Diagnosis Records
model Diagnosis {
  id          String   @id @default(cuid())
  patientId   String
  disorderId  String
  doctorId    String
  sessionId   String?
  notes       String?
  severity    Int?     // 1-10 scale
  status      DiagnosisStatus @default(ACTIVE)
  consentGiven Boolean @default(false)
  diagnosedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  patient   Patient  @relation(fields: [patientId], references: [id])
  disorder  Disorder @relation(fields: [disorderId], references: [id])
  doctor    User     @relation("DoctorDiagnoses", fields: [doctorId], references: [id])
  
  @@map("diagnoses")
  @@index([patientId])
  @@index([disorderId])
  @@index([doctorId])
  @@index([diagnosedAt])
}

// Patient History Tracking
model PatientHistory {
  id        String   @id @default(cuid())
  patientId String
  action    String   // "diagnosis_added", "treatment_updated", etc.
  details   Json?    // Flexible JSON data
  createdAt DateTime @default(now())
  
  patient Patient @relation(fields: [patientId], references: [id])
  
  @@map("patient_history")
  @@index([patientId])
  @@index([createdAt])
}

// Symptoms and Disorder Relationships
model Symptom {
  id           String @id @default(cuid())
  englishName  String
  sanskritName String?
  description  String?
  createdAt    DateTime @default(now())
  
  disorders DisorderSymptom[]
  
  @@map("symptoms")
}

model DisorderSymptom {
  id         String @id @default(cuid())
  disorderId String
  symptomId  String
  relevance  Int    @default(50) // 1-100 scale
  
  disorder Disorder @relation(fields: [disorderId], references: [id])
  symptom  Symptom  @relation(fields: [symptomId], references: [id])
  
  @@unique([disorderId, symptomId])
  @@map("disorder_symptoms")
}

// Analytics and Reporting
model AnalyticsData {
  id        String   @id @default(cuid())
  region    String
  state     String?
  disorder  String
  ageGroup  String
  gender    Gender?
  cases     Int
  trend     TrendType
  period    String   // "2024-Q1", "2024-09", etc.
  createdAt DateTime @default(now())
  
  @@map("analytics_data")
  @@index([region])
  @@index([disorder])
  @@index([period])
}

// EMR Usage Tracking
model EMRUsage {
  id           String   @id @default(cuid())
  sectorType   String   // "Public", "Private", "Ayush"
  region       String
  totalCenters Int
  adoptedCenters Int
  adoptionRate Float
  month        String   // "2024-09"
  createdAt    DateTime @default(now())
  
  @@map("emr_usage")
  @@index([sectorType])
  @@index([region])
  @@index([month])
}

// API Usage Logging
model APIUsage {
  id         String   @id @default(cuid())
  endpoint   String
  method     String
  userId     String?
  ipAddress  String?
  userAgent  String?
  statusCode Int
  responseTime Int?   // milliseconds
  createdAt  DateTime @default(now())
  
  @@map("api_usage")
  @@index([endpoint])
  @@index([userId])
  @@index([createdAt])
}

// Enums
enum UserRole {
  DOCTOR
  GOVERNMENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  CHRONIC
  FOLLOW_UP
}

enum TrendType {
  INCREASING
  DECREASING
  STABLE
}

// ==================== CAMPUS CONNECT HUB MODELS ====================

// Events Model for Campus Connect Hub
model Event {
  id            String      @id @default(cuid())
  title         String
  description   String
  aiSummary     String?     // AI-generated short summary
  longDescription String?   // Detailed description
  eventDate     DateTime
  endDate       DateTime?
  location      String
  venue         String?
  department    String?
  organizer     String
  organizerEmail String?
  eventType     EventType
  category      EventCategory
  tags          String?     // Comma-separated tags like "tech,workshop,free"
  maxAttendees  Int?
  currentAttendees Int     @default(0)
  isPublic      Boolean     @default(true)
  isApproved    Boolean     @default(false)
  isFeatured    Boolean     @default(false)
  registrationUrl String?
  contactInfo   String?
  imageUrl      String?
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  createdBy     User        @relation("EventCreator", fields: [createdById], references: [id])
  attendees     EventAttendee[]
  notifications EventNotification[]
  
  @@map("events")
  @@index([eventDate])
  @@index([department])
  @@index([eventType])
  @@index([category])
  @@index([isApproved])
}

// Event Attendees
model EventAttendee {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  status      AttendanceStatus @default(REGISTERED)
  registeredAt DateTime @default(now())
  attendedAt  DateTime?
  
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([eventId, userId])
  @@map("event_attendees")
}

// Event Notifications & Digests
model EventNotification {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  type        NotificationType
  title       String
  message     String
  isRead      Boolean  @default(false)
  sentAt      DateTime @default(now())
  
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("event_notifications")
  @@index([userId, isRead])
}

// Weekly/Daily Digests
model EventDigest {
  id          String   @id @default(cuid())
  userId      String?  // null means it's a general digest
  title       String
  content     String   // AI-generated digest content
  digestType  DigestType
  weekStart   DateTime?
  weekEnd     DateTime?
  digestDate  DateTime?
  isGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("event_digests")
  @@index([digestType, createdAt])
}

// User Preferences for Events
model UserEventPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  departments     String?  // Comma-separated preferred departments
  eventTypes      String?  // Comma-separated preferred event types
  categories      String?  // Comma-separated preferred categories
  digestFrequency DigestFrequency @default(WEEKLY)
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_event_preferences")
}

// Additional Enums for Campus Connect Hub
enum EventType {
  WORKSHOP
  SEMINAR
  CONFERENCE
  CLUB_MEETING
  SPORTS
  CULTURAL
  HACKATHON
  CAREER_FAIR
  ACADEMIC
  SOCIAL
  OTHER
}

enum EventCategory {
  TECHNOLOGY
  ARTS
  SCIENCE
  BUSINESS
  SPORTS
  CULTURAL
  ACADEMIC
  CAREER
  SOCIAL
  HEALTH
  OTHER
}

enum AttendanceStatus {
  REGISTERED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum NotificationType {
  EVENT_REMINDER
  EVENT_UPDATE
  EVENT_CANCELLED
  DIGEST
  NEW_EVENT
}

enum DigestType {
  DAILY
  WEEKLY
  MONTHLY
}

enum DigestFrequency {
  DAILY
  WEEKLY
  MONTHLY
  NONE
}
